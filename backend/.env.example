# Modelo SLM (GGUF quantizado Q4_K_M, ~3B parâmetros)
MODEL_PATH=./models/model.gguf
# Validação do arquivo do modelo: tamanho mínimo/máximo em MB
MODEL_MIN_MB=500
MODEL_MAX_MB=3000
# Inferência em CPU
LLM_CONTEXT_SIZE=4096
LLM_THREADS=1
LLM_MAX_TOKENS=512

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Autenticação
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Dados (SQLite + arquivos + ChromaDB)
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/normaextractor.db  # opcional; default é <DATA_DIR>/normaextractor.db

# Upload
MAX_UPLOAD_MB=20
MIN_UPLOAD_BYTES=1024

# Chunking
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# RAG
RAG_TOP_K=5

# CORS (separado por vírgula; vazio = mesma origem, frontend servido pelo FastAPI)
CORS_ORIGINS=
